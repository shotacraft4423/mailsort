{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main MailSort window — the default core APIs plus permission to spawn the bundled backend sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/mailsort-backend",
          "sidecar": true,
          "args": false
        }
      ]
    }
  ]
}
